  #|// ----- A.3 Expressions -----
  #|
  #|PrimaryExpression
  #|  = ThisToken { return { type: "ThisExpression" }; }
  #|  / Identifier
  #|  / Literal
  #|  / ArrayLiteral
  #|  / ObjectLiteral
  #|  / "(" __ expression:Expression __ ")" { return expression; }
  #|
  #|ArrayLiteral
