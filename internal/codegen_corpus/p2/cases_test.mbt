        "d", "{}", "{\"error\":{\"name\":\"SyntaxError\",\"message\":\"Expected \\\"a\\\", \\\"b\\\", or \\\"c\\\" but \\\"d\\\" found.\",\"location\":{\"start\":{\"offset\":0,\"line\":1,\"column\":1},\"end\":{\"offset\":1,\"line\":1,\"column\":2}},\"expected\":[{\"type\":\"literal\",\"text\":\"a\",\"ignoreCase\":false},{\"type\":\"literal\",\"text\":\"b\",\"ignoreCase\":false},{\"type\":\"literal\",\"text\":\"c\",\"ignoreCase\":false}],\"found\":\"d\"}}",
      ),
    ],
  ),
  (
