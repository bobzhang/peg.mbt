///|
test "generated parsers match PEG.js" {
  let mut failures = 0
  for c in cases {
    let (name, trace, parse, parses) = c
    for p in parses {
      let (input, options_text, expected_text) = p
      let options = @fixture.parse_options(options_text)
      let tracer : @runtime.Tracer[Unit]? = if trace {
        Some({ trace: _ => (), })
      } else {
        None
      }
      let actual = @fixture.outcome(() => parse(input, options, tracer))
      let expected = @json.parse(expected_text)
      if actual != expected {
        failures += 1
        if failures <= 5 {
          println("\{name} differs on \{input} \{options_text}")
          println("  expected: \{expected.stringify()}")
          println("  actual:   \{actual.stringify()}")
        }
      }
    }
  }
  assert_eq(failures, 0)
}
