///|
let peg_parser : @vm.Parser[Unit] = @vm.Parser::from_fn((input, options, tracer) => {
  @runtime.drive(
    input,
    options,
    tracer,
    allowed_start_rules=["JSON_text"],
    trace=false,
    features={
      text: true,
      offset: true,
      range: true,
      location: true,
      expected: true,
      error: true,
      filename: true,
      default_tracer: true,
    },
    run=(state, start) => {
      let p = PegParser::{
        state,
        actions: peg_actions(@runtime.ActionContext::new(state, [][:], [][:])),
      }
      state.begin()
      match start {
        "JSON_text" => peg_parse_0(p)
        _ => abort("unreachable")
      }
    },
  )
})

///|
/// Parses `input` from `start_rule` (default: the first allowed start
/// rule). `options` is exposed to code blocks through `ctx.options()`.
/// Raises `@runtime.SyntaxError` if the input does not match.
pub fn parse(
  input : String,
  start_rule? : String,
  filename? : String,
  tracer? : @runtime.Tracer[Unit],
  options? : Map[String, PegValue],
) -> PegValue raise {
  peg_parser.parse(input, start_rule?, filename?, tracer?, options?)
}
