    (
      @runtime.string_of_code_units([0xd800]),
      @runtime.string_of_code_units([0xd800]),
    ),
  ]
  for c in cases {
    let (input, expected) = c
    assert_eq(@runtime.js_to_lower(input), expected)
  }
}

